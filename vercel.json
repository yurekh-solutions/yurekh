{
  "rewrites": [
    { "source": "/ainos", "destination": "https://ainos-one.vercel.app/ainos" },
    { "source": "/ainos/(.*)", "destination": "https://ainos-one.vercel.app/ainos/$1" },
    { "source": "/api/(.*)", "destination": "https://ainos-one.vercel.app/ainos/api/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
